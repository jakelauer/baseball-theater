pnpm exec lint-staged

# Canonicalizes the staged notes in docs/v3/backlog/ (like pnpm backlog:build, but from the index:
# derived frontmatter refreshed, each note in its status folder) and re-stages them; refuses notes
# that don't build, and a commit adding back the retired docs/v3/BACKLOG.md (S156).
node scripts/backlog-vault/cli.ts pre-commit --quiet

# Refuses the commit unless the tests its staged files reach (the changed packages and their
# dependents, through Vitest's import graph) pass. See scripts/pre-commit-tests.ts.
node scripts/pre-commit-tests.ts
