// The API and web app as one Cloudflare Worker (S45; ADR-017). `pnpm dev` runs it on
// the local Workers runtime (workerd) with no Cloudflare login. No account id or
// secrets live here: sessions use BT_SESSION_KEY from `.dev.vars` or a deploy secret.
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "baseball-theater",
	"main": "functions/src/worker.ts",
	"compatibility_date": "2026-08-04",
	"compatibility_flags": ["nodejs_compat"],
	// The built SPA. `/api/*` always reaches the Worker; any other unknown path is the
	// app's index.html, so client routes like /games/2024-07-04 load on refresh.
	"assets": {
		"directory": "web/dist",
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/*", "/health"]
	},
	// Once a minute (the cron floor) the cron ensures one game-ingest:<gamePk> object per
	// in-window game (S48; ADR-020); each object's alarm owns that game's ADR-002 cadence.
	// In local dev it runs only with BT_INGEST_TICK=1.
	"triggers": {
		"crons": ["* * * * *"]
	},
	"durable_objects": {
		// S18: game-hub:<gamePk> holds each game's viewers' WebSockets (ADR-020 layer 2).
		// S149: day-hub:<YYYY-MM-DD> holds the scoreboard viewers of one day (ADR-020 as amended 2026-11-16).
		"bindings": [
			{ "name": "GAME_INGEST", "class_name": "GameIngestObject" },
			{ "name": "GAME_HUB", "class_name": "GameHubObject" },
			{ "name": "DAY_HUB", "class_name": "DayHubObject" }
		]
	},
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["GameIngestObject"] },
		{ "tag": "v2", "new_sqlite_classes": ["GameHubObject"] },
		{ "tag": "v3", "new_sqlite_classes": ["DayHubObject"] }
	],
	// Workers Cache (S47, ADR-021; owner, 2026-10-30: "Workers cache"): Cloudflare checks
	// its tiered edge cache before running the Worker and keeps schedule and game responses
	// as long as their Cache-Control says. Every request is then billed at the Workers
	// rate, static assets included (ADR-017's cost line).
	"cache": {
		"enabled": true
	},
	// Postgres through Hyperdrive (ADR-018, S50). No deploy uses this top-level binding or any
	// `id` in this file: each deploy finds its env's config by name (`bt-production`, `bt-staging`,
	// a preview's `bt-preview-pr-<N>`) and writes the id it resolves into the config it deploys
	// (S114, `pnpm deploy:bootstrap`), so the zeros below are placeholders. Locally, `wrangler dev` and the Workers tests connect to
	// `localConnectionString` instead: a local Postgres (S51's Docker), never a hosted database.
	// No credential for one is committed.
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			"id": "00000000000000000000000000000000",
			"localConnectionString": "postgres://bt:bt@localhost:5432/bt"
		}
	],
	// The deployed Workers (S113, S114), deployed only by `.github/workflows/deploy.yml`; agents
	// never deploy (CLAUDE.md). Environments don't inherit bindings, so each env restates the
	// Durable Objects, its Hyperdrive binding and its vars, and names its own Worker, apart from the
	// top-level config's local one, so a deploy without `--env` can never replace a deployed one.
	// The Durable Object `migrations` stay top-level. Every deployed env serves live MLB and names
	// its own address as BT_APP_ORIGIN; BT_SESSION_KEY is a Worker secret that every deploy pushes
	// from GitHub secrets (`--secrets-file`), never a var. None sets BT_LOCAL, so none accepts a
	// `dev:` sign-in (S114 AC 7). Production signs in through Logto (S116), offered only where an
	// env's vars name a tenant (LOGTO_ENDPOINT, LOGTO_APP_ID): production's own tenant, never shared
	// with another env. Staging signs in with the mock test account instead (S143; BT_MOCK_SIGN_IN
	// in env.staging's vars and nowhere else; owner, 2026-11-06: "We will use a staging one or a
	// fake shim"): every Sign in there is one shared test account, and no Logto var may sit beside
	// it (the Worker turns the mock off wherever LOGTO_ENDPOINT or LOGTO_APP_ID is set). Previews
	// offer no sign-in at all (owner, 2026-11-07: "Yes", to previews without sign-in), so their
	// header shows no Sign in.
	"env": {
		// One Worker per pull request (`baseball-theater-pr-<N>` on workers.dev, its name and
		// BT_APP_ORIGIN set at deploy time) on its own Neon branch, `preview-pr-<N>`, a copy of
		// staging's reset from it on every deploy, through its own Hyperdrive config,
		// `bt-preview-pr-<N>`, whose id the deploy resolves by name into the config it deploys
		// (issue #42; owner, 2026-11-13: "Yes, do that."). No cron: a preview reads MLB through on request only, so open pull requests
		// don't each poll on ADR-002's cadence.
		"preview": {
			"name": "baseball-theater-preview",
			"workers_dev": true,
			"triggers": {
				"crons": []
			},
			"durable_objects": {
				"bindings": [
					{ "name": "GAME_INGEST", "class_name": "GameIngestObject" },
					{ "name": "GAME_HUB", "class_name": "GameHubObject" },
					{ "name": "DAY_HUB", "class_name": "DayHubObject" }
				]
			},
			"hyperdrive": [
				{
					"binding": "HYPERDRIVE",
					"id": "00000000000000000000000000000000"
				}
			],
			"vars": {
				"BT_USE_LIVE_MLB": "1"
			}
		},
		// Every push to stage that changes code (a docs-only one deploys nothing), at stage.baseball.theater, on the Neon `staging` branch through
		// `bt-staging`: a schema-only branch that never holds a fan's data (S114 AC 9).
		"staging": {
			"name": "baseball-theater-staging",
			"workers_dev": false,
			// Smart Placement (issue #532): run the fetch handler near Neon (us-east-2), not where the
			// request landed, as each Postgres round trip from far away cost ~70 ms. Crons and Durable
			// Objects are not moved. Per env, never top-level, so local dev and previews keep the default.
			// S220: staging alone adds a placement hint, Neon's own region, so the whole Worker (its
			// per-minute cron included, which Smart Placement alone doesn't move) runs beside the database;
			// production takes it only through a later change the owner approves once staging's round-trip
			// log lines (kind `cron`) show it helps.
			"placement": { "mode": "smart", "hint": "aws:us-east-2" },
			"routes": [{ "pattern": "stage.baseball.theater", "custom_domain": true }],
			"durable_objects": {
				"bindings": [
					{ "name": "GAME_INGEST", "class_name": "GameIngestObject" },
					{ "name": "GAME_HUB", "class_name": "GameHubObject" },
					{ "name": "DAY_HUB", "class_name": "DayHubObject" }
				]
			},
			"hyperdrive": [
				{
					"binding": "HYPERDRIVE",
					"id": "00000000000000000000000000000000"
				}
			],
			"vars": {
				"BT_USE_LIVE_MLB": "1",
				"BT_APP_ORIGIN": "https://stage.baseball.theater",
				"BT_MOCK_SIGN_IN": "1",
				// Staging's backer tier override (S215; owner, 2026-11-24: "This functionality must not be
				// available or visible in production."), for testing only: set here and nowhere else, and the
				// Worker honours it only beside the mock sign-in (`tierOverrideAllowed`), so production, which
				// names a Logto tenant, refuses it on the server even if this line were copied there. It never
				// changes a tester's real tier or touches Patreon.
				"BT_TIER_OVERRIDE": "1",
				// S220: each game's ingest Durable Object is created near Neon (us-east-2): `enam`, eastern North
				// America, the nearest of Cloudflare's location hints. Staging only, beside the round-trip log lines
				// (kind `ingest`); production gets it only through a later change the owner approves. A hint counts
				// only when an object is first made, so games already in their window keep their place.
				"BT_INGEST_LOCATION_HINT": "enam"
			}
		},
		// Every published GitHub Release (S121), at next.baseball.theater until the owner's DNS cutover (S119; owner,
		// 2026-11-07: "Do the temporary address"): baseball.theater still points at the Elastic
		// Beanstalk (v2) site, and a deploy that claimed it would replace that DNS record at once.
		// Cutting over is the owner's step: set this route and BT_APP_ORIGIN to baseball.theater
		// (README). Its Hyperdrive config is `bt-production`, which the owner created on
		// 2026-11-02 for the Neon project `old-sun-72319473` (Postgres 18); its connection string
		// lives only in Cloudflare. Its Logto tenant (S116; the owner's, at the custom domain
		// auth.baseball.theater, tenant ID `rnrngs`) signs fans in through the single-page app
		// LOGTO_APP_ID; the Management API is reached at rnrngs.logto.app (Logto Cloud serves it on no
		// custom domain) by the machine-to-machine app whose ID and secret are Worker secrets.
		// Every production deploy registers the app's sign-in and sign-out addresses from
		// BT_APP_ORIGIN (`pnpm deploy:logto`), so the cutover moves them too.
		"production": {
			"name": "baseball-theater-production",
			"workers_dev": false,
			// Smart Placement, as staging (issue #532).
			"placement": { "mode": "smart" },
			"routes": [{ "pattern": "next.baseball.theater", "custom_domain": true }],
			"durable_objects": {
				"bindings": [
					{ "name": "GAME_INGEST", "class_name": "GameIngestObject" },
					{ "name": "GAME_HUB", "class_name": "GameHubObject" },
					{ "name": "DAY_HUB", "class_name": "DayHubObject" }
				]
			},
			"hyperdrive": [
				{
					"binding": "HYPERDRIVE",
					"id": "00000000000000000000000000000000"
				}
			],
			"vars": {
				"BT_USE_LIVE_MLB": "1",
				"BT_APP_ORIGIN": "https://next.baseball.theater",
				"LOGTO_ENDPOINT": "https://auth.baseball.theater",
				"LOGTO_APP_ID": "1b1sc2uclfqak0swrahef",
				"LOGTO_TENANT_ID": "rnrngs"
			}
		}
	},
	// No anonymous usage telemetry from local runs.
	"send_metrics": false,
	"observability": {
		"enabled": true
	}
}
