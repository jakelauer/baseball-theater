{
	"name": "@bt/mlb-api",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		}
	},
	"scripts": {
		"typecheck": "tsc -p tsconfig.json --noEmit --incremental --tsBuildInfoFile tsconfig.tsbuildinfo",
		"test": "vitest run --coverage --coverage.reporter=text-summary --coverage.reporter=json-summary --reporter=dot --silent=passed-only ${BT_VITEST_MAX_WORKERS:+--maxWorkers=$BT_VITEST_MAX_WORKERS}",
		"lint": "eslint .",
		"test:fast": "vitest run"
	},
	"dependencies": {
		"zod": "^3.24.2"
	},
	"devDependencies": {
		"typescript": "^5.8.2",
		"vitest": "^3.0.8"
	}
}
