{
	"name": "baseball-theater",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"packageManager": "pnpm@9.15.0",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"preinstall": "npx only-allow pnpm",
		"dev": "docker compose up -d --wait postgres && pnpm db:seed && concurrently -n api,web -c blue,green \"pnpm --filter @bt/functions dev\" \"pnpm --filter @bt/web dev\"",
		"db:seed": "pnpm --filter @bt/functions exec tsx src/scripts/db-seed.ts",
		"seed:refresh": "pnpm --filter @bt/functions exec tsx src/scripts/seed-refresh.ts",
		"db:migrate": "pnpm --filter @bt/functions exec tsx src/scripts/db-migrate.ts",
		"db:copy-baseball": "pnpm --filter @bt/functions exec tsx src/scripts/db-copy-baseball.ts",
		"db:reapply-deletions": "pnpm --filter @bt/functions exec tsx src/scripts/db-reapply-deletions.ts",
		"deploy:bootstrap": "pnpm --filter @bt/functions exec tsx src/scripts/deploy-bootstrap.ts",
		"deploy:logto": "pnpm --filter @bt/functions exec tsx src/scripts/deploy-logto.ts",
		"deploy:teardown": "pnpm --filter @bt/functions exec tsx src/scripts/deploy-teardown.ts",
		"deploy:cleanup-previews": "pnpm --filter @bt/functions exec tsx src/scripts/deploy-cleanup-previews.ts",
		"build": "pnpm lint && turbo run build --cache=local:${BT_TURBO_CACHE_READ:+r}${GITHUB_ACTIONS:+w}",
		"typecheck": "turbo run typecheck --cache=local:${BT_TURBO_CACHE_READ:+r}${GITHUB_ACTIONS:+w}",
		"lint": "pnpm backlog:check && eslint . ${GITHUB_ACTIONS:+--cache --cache-strategy content --cache-location .eslintcache}",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "vitest run",
		"test:coverage": "turbo run test:coverage --cache=local:${BT_TURBO_CACHE_READ:+r}${GITHUB_ACTIONS:+w} && pnpm test:backlog && pnpm test:tools && pnpm test:selector",
		"test:watch": "vitest",
		"test:backlog": "vitest run --config scripts/backlog-vault/vitest.config.ts",
		"test:tools": "vitest run --config tools/vitest.config.js",
		"test:selector": "cd e2e && vitest run",
		"dup:check": "jscpd --config .jscpd.json",
		"comments:stale": "node tools/comments-stale/comments-stale.js",
		"verify": "pnpm build && pnpm dup:check && pnpm test:coverage && pnpm size",
		"mlb:backfill": "pnpm --filter @bt/functions exec tsx src/scripts/backfill.ts",
		"mlb:scan-drift": "pnpm --filter @bt/functions exec tsx src/scripts/scan-drift.ts",
		"api:spec": "pnpm --filter @bt/functions exec tsx src/scripts/generate-openapi.ts",
		"api:breaking": "pnpm --filter @bt/functions exec tsx src/scripts/api-breaking.ts",
		"api:types": "pnpm --filter @bt/web api:types",
		"backlog:build": "node scripts/backlog-vault/cli.ts build",
		"backlog:check": "node scripts/backlog-vault/cli.ts check",
		"backlog:import": "node scripts/backlog-vault/cli.ts import",
		"changelog:build": "node scripts/backlog-vault/changelog.ts",
		"parity:debt": "scripts/parity-debt.sh",
		"goal": "scripts/goal.sh",
		"prepare": "husky",
		"size": "size-limit --json",
		"design:capture": "BT_DESIGN_CAPTURE=1 playwright test --config e2e/playwright.config.ts",
		"design:review": "node e2e/design-review.ts",
		"e2e": "playwright test --config e2e/playwright.config.ts --workers=4 flows/ design/harness.spec.ts",
		"e2e:design": "playwright test --config e2e/playwright.config.ts design/",
		"lighthouse": "cd e2e && lhci autorun --config=../lighthouserc.json",
		"lighthouse:serve": "concurrently -k -n api,web \"pnpm --filter @bt/functions exec tsx src/local-server.ts\" \"node scripts/wait-for-port.ts 8787 && pnpm --filter @bt/web exec vite preview --port 4173 --strictPort\""
	},
	"devDependencies": {
		"@eslint/js": "^9.22.0",
		"@lhci/cli": "0.15.1",
		"@playwright/test": "1.64.1",
		"@size-limit/file": "^14.2.0",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@types/node": "^22.13.10",
		"@vitest/coverage-v8": "^3.0.8",
		"concurrently": "^9.1.2",
		"eslint": "^9.22.0",
		"eslint-config-prettier": "^10.1.1",
		"eslint-plugin-react-hooks": "^5.2.0",
		"eslint-plugin-react-refresh": "^0.4.19",
		"eslint-plugin-require-extensions": "^0.1.3",
		"eslint-plugin-unused-imports": "^4.4.1",
		"globals": "^16.0.0",
		"husky": "^9.1.7",
		"jscpd": "^5.4.1",
		"lint-staged": "^15.5.0",
		"only-allow": "^1.2.1",
		"prettier": "^3.5.3",
		"size-limit": "^14.2.0",
		"turbo": "^2",
		"typescript": "^5.8.2",
		"typescript-eslint": "^8.26.1",
		"vitest": "^3.0.8",
		"yaml": "^2.9.0"
	},
	"lint-staged": {
		"*.{ts,tsx,js,jsx,mjs,cjs}": [
			"eslint --fix"
		],
		"*.{json,md,yml,yaml,css,scss,html}": [
			"prettier --write"
		]
	}
}
