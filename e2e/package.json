{
	"name": "@bt/e2e",
	"private": true,
	"type": "module",
	"description": "Browser specs (run by pnpm e2e, never by pnpm verify: law P8), the spec selector and the design-review tool (ADR-030 rule 1).",
	"scripts": {
		"lint": "eslint .",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"test": "vitest run --coverage --coverage.reporter=text-summary --coverage.reporter=json-summary --reporter=dot --silent=passed-only ${BT_VITEST_MAX_WORKERS:+--maxWorkers=$BT_VITEST_MAX_WORKERS}",
		"test:fast": "vitest run"
	}
}
