# Dependencies
node_modules/
.pnpm-store/

# Build / caches
dist/
build/
.turbo/
coverage/
*.tsbuildinfo

# Env / secrets
.env
.env.*
!.env.example
*.pem
keys.json
service-account*.json

# Wrangler local state and local Worker vars (S45)
.wrangler/
.dev.vars

# The dev seed: real MLB days and games recorded by `pnpm seed:refresh` (S112), loaded by `pnpm dev`
.dev-seed/

# The game backfill's resume state, one file per target database (S122, `pnpm mlb:backfill`)
.backfill/

# IDE / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Logs
*.log
npm-debug.log*
ui-debug.log*

# Husky local
.husky/_

# Obsidian workspace/settings for the backlog notes (docs/v3/VAULT-MIGRATION.md V3)
docs/v3/backlog/.obsidian/

# Playwright output (S81); design captures live in docs/v3/design-checks/
e2e/test-results/
e2e/playwright-report/

# Design-match pairs laid out for the owner (pnpm design:review); delete a story's folder after the verdict
.designreview/

# What waits on the owner (designs in review and their questions), written on request; local notes, never committed
.pending/

# Obsidian window/pane layout for the docs/v3 vault: changes every time the vault is opened
docs/v3/.obsidian/workspace.json
# The Obsidian Bases view of the backlog: Obsidian rewrites it on open; `pnpm backlog:build` seeds a default when it is missing
docs/v3/backlog/Backlog.base

# ESLint's cache (S152: `pnpm lint` runs it with --cache; CI keeps it between runs)
.eslintcache
# Vitest shard reports, merged by CI's functions-coverage job (S152)
.vitest-reports/

# A parallel /run-backlog's overseer state: in-flight claims and gathered findings (S156, scripts/backlog-vault/claims.ts)
.run/
# Other checkouts of this repository, one per backlog item (S156, #110: scripts/worktree-for.sh), and
# each one's ports and Compose project name (already covered by `.env.*`; named so the reason is here)
.claude/worktrees/
.env.worktree
# Built by pnpm backlog:build (the post-checkout and post-merge hooks run it), never committed (S156)
docs/v3/INDEX.md
docs/v3/audit.jsonl
# A ledger entry scripts/audit.sh was killed while writing (it writes `.<name>.<pid>.tmp`, then links it into place)
docs/v3/audit/**/.*.tmp

# The backlog issue cache (S164): pnpm backlog:sync writes it in the main checkout; never committed.
.backlog-cache/

# Python bytecode caches (a reviewer's python3 -m unittest writes them; plan-review.test.ts runs with PYTHONDONTWRITEBYTECODE=1)
__pycache__/
