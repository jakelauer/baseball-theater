{
	"$schema": "https://turbo.build/schema.json",
	// ADR-030 (S168): every area with code and tests is a unit with its own lint / typecheck / test
	// (/ build / size) tasks, each task depends only on what it consumes, and each declares its inputs.
	// globalDependencies holds only the toolchain files that reach every task (ADR-030's "Toolchain
	// files" line); every other file outside a unit is an input of exactly the tasks that read it.
	// This file holds only the tasks `pnpm verify` (scripts/verify.sh) runs; a convenience is a unit
	// script run with `pnpm --filter`, never a task here.
	"globalDependencies": ["pnpm-lock.yaml", "tsconfig.base.json", ".nvmrc", "turbo.json", "eslint.config.js"],
	"tasks": {
		// A dependency's source reaches a task's hash only through a dependency edge, so lint, test and
		// build wait on the (seconds-long) type checks below them, never on another unit's tests (rule 5).
		"typecheck": {
			"dependsOn": ["^typecheck"],
			"inputs": ["$TURBO_DEFAULT$"],
			"outputs": []
		},
		// Every lint loads the custom rules, so a change to one reruns every lint.
		"lint": {
			"dependsOn": ["^typecheck"],
			"inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/tools/eslint-rules/**"],
			"outputs": []
		},
		// The coverage summaries are restored on a replay. BT_COVERAGE_SHARD and BT_FUNCTIONS_SHARDED change
		// what functions' tests run (CI's shard jobs), so they are part of the hash.
		"test": {
			"dependsOn": ["^typecheck"],
			"inputs": ["$TURBO_DEFAULT$"],
			"outputs": ["coverage/**"],
			"env": ["BT_FUNCTIONS_SHARDED", "BT_COVERAGE_SHARD"]
		},
		"build": {
			"dependsOn": ["^typecheck"],
			"inputs": ["$TURBO_DEFAULT$"],
			"outputs": ["dist/**"]
		},
		"size": {
			"dependsOn": ["build"],
			"inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/.size-limit.json"],
			"outputs": []
		},
		// Cross-unit read (S146): web/vite.config.ts imports functions/src/deploy/vite-plugin.ts, with no
		// workspace dependency between the two units, so web's build, lint and typecheck name it.
		"@bt/web#build": {
			"dependsOn": ["^typecheck"],
			"inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/functions/src/deploy/vite-plugin.ts"],
			"outputs": ["dist/**"]
		},
		"@bt/web#lint": {
			"dependsOn": ["^typecheck"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"$TURBO_ROOT$/tools/eslint-rules/**",
				"$TURBO_ROOT$/functions/src/deploy/vite-plugin.ts"
			],
			"outputs": []
		},
		"@bt/web#typecheck": {
			"dependsOn": ["^typecheck"],
			"inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/functions/src/deploy/vite-plugin.ts"],
			"outputs": []
		},
		// functions' tests read the fixtures, the API spec, wrangler.jsonc, the release notes, the
		// workflows and the preview script, (S146) web/vite.config.ts's text and the root package.json's
		// scripts, and .prettierrc (the committed spec is formatted with it).
		"@bt/functions#test": {
			"dependsOn": ["^typecheck"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"$TURBO_ROOT$/fixtures/**",
				"$TURBO_ROOT$/openapi/**",
				"$TURBO_ROOT$/wrangler.jsonc",
				"$TURBO_ROOT$/releases/**",
				"$TURBO_ROOT$/.github/workflows/**",
				"$TURBO_ROOT$/scripts/preview-pr-open.sh",
				"$TURBO_ROOT$/web/vite.config.ts",
				"$TURBO_ROOT$/package.json",
				"$TURBO_ROOT$/.prettierrc"
			],
			"outputs": ["coverage/**", ".vitest-reports/**"],
			"env": ["BT_FUNCTIONS_SHARDED", "BT_COVERAGE_SHARD"]
		},
		// The recorded MLB fixtures domain's, mlb-api's and web's tests read (web's also the API spec
		// its generated client is checked against), each found by AC 4's isolated-copy runs.
		"@bt/domain#test": {
			"dependsOn": ["^typecheck"],
			"inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/fixtures/**"],
			"outputs": ["coverage/**"],
			"env": ["BT_FUNCTIONS_SHARDED", "BT_COVERAGE_SHARD"]
		},
		"@bt/mlb-api#test": {
			"dependsOn": ["^typecheck"],
			"inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/fixtures/**"],
			"outputs": ["coverage/**"],
			"env": ["BT_FUNCTIONS_SHARDED", "BT_COVERAGE_SHARD"]
		},
		"@bt/web#test": {
			"dependsOn": ["^typecheck"],
			"inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/fixtures/**", "$TURBO_ROOT$/openapi/**"],
			"outputs": ["coverage/**"],
			"env": ["BT_FUNCTIONS_SHARDED", "BT_COVERAGE_SHARD"]
		},
		// tools' tests run jscpd and size-limit with the repository's own configs and the root
		// package.json's size command.
		"@bt/tools#test": {
			"dependsOn": ["^typecheck"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"$TURBO_ROOT$/.jscpd.json",
				"$TURBO_ROOT$/.size-limit.json",
				"$TURBO_ROOT$/package.json"
			],
			"outputs": ["coverage/**"],
			"env": ["BT_FUNCTIONS_SHARDED", "BT_COVERAGE_SHARD"]
		},
		// e2e's design-review helper imports scripts/backlog-vault/design-reference.ts (one pairing rule
		// for the review folder and the ledger), and its spec selector reads each unit's manifest.
		"@bt/e2e#lint": {
			"dependsOn": ["^typecheck"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"$TURBO_ROOT$/tools/eslint-rules/**",
				"$TURBO_ROOT$/scripts/backlog-vault/design-reference.ts"
			],
			"outputs": []
		},
		"@bt/e2e#typecheck": {
			"dependsOn": ["^typecheck"],
			"inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/scripts/backlog-vault/design-reference.ts"],
			"outputs": []
		},
		"@bt/e2e#test": {
			"dependsOn": ["^typecheck"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"$TURBO_ROOT$/scripts/backlog-vault/design-reference.ts",
				"$TURBO_ROOT$/packages/domain/package.json",
				"$TURBO_ROOT$/packages/mlb-api/package.json",
				"$TURBO_ROOT$/packages/ports/package.json",
				"$TURBO_ROOT$/functions/package.json",
				"$TURBO_ROOT$/web/package.json"
			],
			"outputs": ["coverage/**"],
			"env": ["BT_FUNCTIONS_SHARDED", "BT_COVERAGE_SHARD"]
		},
		// The law-test unit (rule 4): its tests read the whole repository's structure, so every file
		// outside scripts/ they read is named here, each unit's manifest by name (law (c)), and the
		// configs worktree-ports.test.ts imports with every file they import in turn.
		"@bt/scripts#test": {
			"dependsOn": ["^typecheck"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"$TURBO_ROOT$/package.json",
				"$TURBO_ROOT$/pnpm-workspace.yaml",
				"$TURBO_ROOT$/packages/domain/package.json",
				"$TURBO_ROOT$/packages/mlb-api/package.json",
				"$TURBO_ROOT$/packages/ports/package.json",
				"$TURBO_ROOT$/functions/package.json",
				"$TURBO_ROOT$/web/package.json",
				"$TURBO_ROOT$/scripts/package.json",
				"$TURBO_ROOT$/tools/package.json",
				"$TURBO_ROOT$/e2e/package.json",
				"$TURBO_ROOT$/packages/domain/vitest.config.ts",
				"$TURBO_ROOT$/packages/mlb-api/vitest.config.ts",
				"$TURBO_ROOT$/packages/ports/vitest.config.ts",
				"$TURBO_ROOT$/functions/vitest.config.ts",
				"$TURBO_ROOT$/web/vitest.config.ts",
				"$TURBO_ROOT$/tools/vitest.config.js",
				"$TURBO_ROOT$/e2e/vitest.config.ts",
				"$TURBO_ROOT$/.github/**",
				"$TURBO_ROOT$/.claude/skills/**",
				"$TURBO_ROOT$/.claude/agents/**",
				"$TURBO_ROOT$/.claude/settings.json",
				"$TURBO_ROOT$/.husky/**",
				"$TURBO_ROOT$/docs/**",
				"$TURBO_ROOT$/changelog.d/**",
				"$TURBO_ROOT$/releases/**",
				"$TURBO_ROOT$/CLAUDE.md",
				"$TURBO_ROOT$/CHANGELOG.md",
				"$TURBO_ROOT$/.gitignore",
				"$TURBO_ROOT$/.size-limit.json",
				"$TURBO_ROOT$/.jscpd.json",
				"$TURBO_ROOT$/web/vite.config.ts",
				"$TURBO_ROOT$/web/src/layout/version.ts",
				"$TURBO_ROOT$/web/src/pwa/**",
				"$TURBO_ROOT$/packages/domain/src/release-notes.ts",
				"$TURBO_ROOT$/packages/domain/src/calendar-date.ts",
				"$TURBO_ROOT$/e2e/playwright.config.ts",
				"$TURBO_ROOT$/functions/src/**",
				"$TURBO_ROOT$/web/src/api/codegen.test.ts"
			],
			"outputs": ["coverage/**"]
		},
		// Repo-wide root tasks (rule 3): each reads files of every unit at once and runs no ESLint, tsc
		// or Vitest. No edge joins them to a unit's task. Each names the root package.json, which holds
		// its command.
		"//#backlog:check": {
			"inputs": [
				"$TURBO_ROOT$/docs/**",
				"$TURBO_ROOT$/changelog.d/**",
				"$TURBO_ROOT$/scripts/**",
				"$TURBO_ROOT$/CLAUDE.md",
				"$TURBO_ROOT$/package.json",
				"$TURBO_ROOT$/.github/**"
			],
			"outputs": []
		},
		"//#dup:check": {
			"inputs": [
				"$TURBO_ROOT$/package.json",
				"$TURBO_ROOT$/.jscpd.json",
				"$TURBO_ROOT$/packages/**",
				"$TURBO_ROOT$/functions/src/**",
				"$TURBO_ROOT$/web/src/**"
			],
			"outputs": []
		},
		// Prettier's Markdown check; .prettierignore leaves out docs/, so these are the places Markdown lives.
		"//#format:md": {
			"inputs": [
				"$TURBO_ROOT$/package.json",
				"$TURBO_ROOT$/.prettierignore",
				"$TURBO_ROOT$/.prettierrc",
				"$TURBO_ROOT$/CLAUDE.md",
				"$TURBO_ROOT$/CHANGELOG.md",
				"$TURBO_ROOT$/README.md",
				"$TURBO_ROOT$/changelog.d/**",
				"$TURBO_ROOT$/releases/**",
				"$TURBO_ROOT$/.claude/**",
				"$TURBO_ROOT$/.github/**",
				"$TURBO_ROOT$/web/src/pages/legal/**",
				"$TURBO_ROOT$/scripts/backlog-vault/fixtures/**"
			],
			"outputs": []
		}
	},
	// TMPDIR reaches the tasks without entering any hash: in strict mode, with it stripped, functions'
	// tests timed out on the shared temp folder (see S152's note). A worktree's ports and Compose project
	// (`.env.worktree`, scripts/worktree-for.sh, S156) pass through the same way: stripped, the workerd
	// tests' PGlite socket fell back to 54329 and two worktrees' `pnpm verify` collided (EADDRINUSE).
	// BT_VITEST_MAX_WORKERS is the entry point's Vitest worker cap (ADR-030 rule 7, issue #643).
	"globalPassThroughEnv": [
		"TMPDIR",
		"PGLITE_PORT",
		"BT_API_PORT",
		"BT_WEB_PORT",
		"BT_PG_PORT",
		"BT_WORKTREE_SLOT",
		"COMPOSE_PROJECT_NAME",
		"CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE",
		"BT_VITEST_MAX_WORKERS"
	]
}
